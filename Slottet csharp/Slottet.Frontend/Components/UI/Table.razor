@typeparam TItem
<!-- Table component which uses the Button component, and uses typeparam TItem for dynamic item rendering, which lets 
     you pass data of any type to the table, no matter how many attributes each item has -->


<div class="container-fluid p-0 mt-4">
    <div class="mb-3">
        
        <!-- Add button, triggers the OnAdd event when clicked -->
        <Button Variant="BrandButtonType.Matcha" 
                  OnClick="OnAdd">
            <ChildContent>
                <i class="bi bi-plus-lg me-2"></i> @AddButtonText
            </ChildContent>
        </Button>
    </div>

    <div class="card shadow-sm border-0 overflow-hidden">
        <div class="table-responsive">
            <table class="table table-striped custom-crud-table mb-0">
                <thead>
                    <tr>
                        @TableHeader
                        <th class="text-center" style="width: 250px;">Mugligheder</th>
                    </tr>
                </thead>
                <tbody>
                    @if (Items != null && Items.Any())
                    {
                        
                        @if (RowTemplate != null)
                        {
                            <!-- Loops through each item passed to the table, and renders two buttons for edit and delete for each item, which passes the item as a parameter -->
                            @foreach (var item in Items)
                            {
                                <tr>
                                    @RowTemplate(item)
                                    <td class="text-center">
                                        <div class="d-flex justify-content-center gap-2">
                                            <Button Variant="BrandButtonType.Beige"                                                    
                                                    OnClick="@(() => OnEdit.InvokeAsync(item))">
                                                <ChildContent>
                                                    <i class="bi bi-pencil-fill me-1"></i> Rediger
                                                </ChildContent>
                                            </Button>

                                            <Button Variant="BrandButtonType.Danger" 
                                                    OnClick="@(() => OnDelete.InvokeAsync(item))">
                                                <ChildContent>
                                                    <i class="bi bi-trash-fill me-1"></i> Slet
                                                </ChildContent>

                                            </Button>
                                        </div>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="100%" class="text-center py-4">
                                    <p class="mb-0">Ingen data at vise</p>
                                </td>
                            </tr>
                        }             
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@code {
    [Parameter] public IEnumerable<TItem>? Items { get; set; }
    [Parameter] public RenderFragment? TableHeader { get; set; }
    [Parameter] public RenderFragment<TItem>? RowTemplate { get; set; }
    
    [Parameter] public string AddButtonText { get; set; } = "Add New";
    
    // Events
    [Parameter] public EventCallback OnAdd { get; set; }
    [Parameter] public EventCallback<TItem> OnEdit { get; set; }
    [Parameter] public EventCallback<TItem> OnDelete { get; set; }
}