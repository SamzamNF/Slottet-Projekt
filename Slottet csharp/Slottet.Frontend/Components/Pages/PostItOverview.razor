@page "/"
@using Slottet.Shared.DTO

<h3><strong>Overblik over alle beboere</strong></h3>

<div class="d-flex flex-column min-vh-100">
    <div class="container-fluid flex-grow-1 px-4 pb-5">

        @* ===================== UI: Date-Bar (History) ===================== *@

        <div class="d-flex justify-content-between align-items-center bg-light mb-4 rounded p-3">
            <button class="btn btn-primary px-3 py-2 shadow-sm" aria-label="Forrige dag">
                <i class="bi bi-chevron-left fs-4"></i>
            </button>
            <h3 class="fw-bold mb-0">@currentDate.ToString("dd. MMMM yyyy", Danish)</h3>
            <button class="btn btn-primary px-3 py-2 shadow-sm" aria-label="Næste dag">
                <i class="bi bi-chevron-right fs-4"></i>
            </button>
        </div>

        @* ===================== UI: POST-IT card ===================== *@

        <div class="row g-4">
            @foreach (var postIt in PostIts)
            {
                <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                    @* PostIt-component is used here *@
                    <PostIt PostItItem="postIt" OnClick="OpenPostItModal" />
                </div>
            }
        </div>

    </div>
</div>

@* ===================== UI: Edit modal ===================== *@

@if (selectedPostIt != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header border-0 text-white bg-secondary">
                    <h5 class="modal-title">Rediger Post-it: @selectedPostIt.ResidentInitials</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    @* API *@
                </div>
                <div class="modal-footer border-top-0 bg-light">
                    <button type="button" class="btn btn-secondary" @onclick="CloseModal">Annuller</button>
                    <button type="button" class="btn btn-success" @onclick="SaveChanges">Gem ændringer</button>
                </div>
            </div>
        </div>
    </div>
}

