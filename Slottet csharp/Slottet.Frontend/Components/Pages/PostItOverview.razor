@using Microsoft.AspNetCore.Components.Authorization
@using Slottet.Shared.DTO

@page "/"
@rendermode InteractiveServer

@inject ApiService ApiService

<AuthorizeView Roles="Admin,Personale">
    <Authorized>
        <h3><strong>Overblik over alle beboere</strong></h3>

        <div class="d-flex flex-column min-vh-100">
            <div class="container-fluid flex-grow-1 px-4 pb-5">

                @* -------------------- Date-Bar -------------------- *@

                <div class="d-flex justify-content-between align-items-center mb-4 bg-light rounded p-3">
                    <button class="btn px-3 py-2 shadow-sm" style="background-color: #44985D; color: white;" @onclick="PreviousDay" aria-label="Forrige dag">
                        <i class="bi bi-chevron-left fs-4"></i>
                    </button>
                    <h3 class="fw-bold mb-0">@currentDate.ToString("dd. MMMM yyyy", Danish)</h3>
                    <button class="btn px-3 py-2 shadow-sm" style="background-color: #44985D; color: white;" @onclick="NextDay" disabled="@(currentDate >= DateTime.Today)" aria-label="Næste dag">
                        <i class="bi bi-chevron-right fs-4"></i>
                    </button>
                </div>

                @* -------------------- Post-It cards -------------------- *@

                <div class="row g-4">
                    @foreach (var postIt in PostIts)
                    {
                        <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                            <PostIt PostItItem="postIt" />
                        </div>
                    }
                </div>

            </div>
        </div>
    </Authorized>

    <NotAuthorized>
        <div class="container mt-5 text-center">
            <i class="bi bi-shield-lock display-1 text-danger"></i>
            <h2 class="mt-3">Adgang nægtet</h2>
            <p class="text-danger fw-bold">Du har ikke de nødvendige rettigheder for at se denne side.</p>
            <p class="text-danger fw-bold mt-4">Log venligst ind for at få adgang.</p>
        </div>
    </NotAuthorized>

</AuthorizeView>

@code {
    // ---- Danish dates ----
    private readonly System.Globalization.CultureInfo Danish = new("da-DK");

    private DateTime currentDate = DateTime.Today;
    private List<PostItDTO> PostIts = new();
    private string? errorMessage;

    // ---- Load data from API ----
    protected override async Task OnInitializedAsync()
    {
        await LoadPostIts();
    }

    // ---- Load post-its for selected date ----
    private async Task LoadPostIts()
    {
        try
        {
            var result = await ApiService.GetListAsync<PostItDTO>($"api/postit/history/date?date={currentDate:yyyy-MM-dd}");
            PostIts = result ?? new List<PostItDTO>();
        }
        catch (Exception ex)
        {
            errorMessage = ex.Message;
        }
    }

    // ---- Date navigation ----
    private async Task PreviousDay()
    {
        currentDate = currentDate.AddDays(-1);
        await LoadPostIts();
    }

    private async Task NextDay()
    {
        if (currentDate < DateTime.Today)
        {
            currentDate = currentDate.AddDays(1);
            await LoadPostIts();
        }
    }
}

