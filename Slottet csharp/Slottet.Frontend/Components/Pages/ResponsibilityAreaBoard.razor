@using Microsoft.AspNetCore.Components.Authorization
@using MudBlazor
@using Slottet.Shared.DTO

@rendermode InteractiveServer
@page "/responsibility-area-board"

@inject ApiService ApiService
@inject ISnackbar Snackbar
@inject NavigationManager NavigationManager

<AuthorizeView Roles="Admin,Personale">
    <Authorized>
        <div class="container mt-5">
            <div class="d-flex justify-content-between align-items-center mb-4">
                <h2 class="text-brand-matcha m-0">Ansvarsområder</h2>
            </div>

            @* Filter controls *@
    <div class="row mb-4">
        <div class="col-md-4">
            <label class="form-label fw-bold text-brand-matcha">Filtrer efter dato</label>
            <div class="input-group">
                <input type="date" class="form-control" @bind="_selectedFilterDate" @bind:event="oninput" />
                @if (_selectedFilterDate.HasValue)
                {
                    <Button OnClick="ClearFilter"
                            Variant="BrandButtonType.Matcha"
                            VariableText="Ryd filter">
                    </Button>
                }
            </div>
        </div>
    </div>

    @* EventCallBacks (OnAdd, OnEdit, OnDelete, handles passing the item as a parameter, in the component)*@
    <Table TItem="ResponsibilityAreaDTO" 
                  Items="@GetFilteredResponsibilityAreas()" 
                  AddButtonText="Opret Ansvarsområde"
                  PageSize="10"
                  ShowAction="false"
                  ShowAdd="false">
        
        <TableHeader>
            <th>Beskrivelse</th>
            <th>Dato</th>
            <th>Medarbejder</th>
            <th>Telefonnummer</th>
        </TableHeader>

        <RowTemplate Context="responsibilityArea">
            <td class="fw-bold text-brand-matcha">@responsibilityArea.Description</td>
                <td>@responsibilityArea.Date.ToString("dd-MM-yyyy")</td>
                <td>@responsibilityArea.StaffInitials</td>
                <td>@responsibilityArea.PhoneNumber</td>
        </RowTemplate>

    </Table>

        </div>

        <AuthorizeView Roles="Admin" Context="adminContext">
            <div class="container mt-5 centered">
                 <Button OnClick="NavigateToCreatePage"
                         Variant="BrandButtonType.Matcha"
                         VariableText="Opret nyt ansvarsområde">

                    <ChildContent>
                        <i class="bi bi-plus-lg me-2"></i> Opret nyt ansvarsområde
                    </ChildContent>
                 </Button>
            </div>

        </AuthorizeView>
    </Authorized>

    

    <NotAuthorized>
        <div class="container mt-5 text-center">
            <i class="bi bi-shield-lock display-1 text-danger"></i>
            <h2 class="mt-3">Adgang nægtet</h2>
            <p class="text-danger fw-bold">Du har ikke de nødvendige rettigheder for at se denne side.</p>
            <p class="text-danger fw-bold mt-4">Log venligst ind for at få adgang.</p>
        </div>
    </NotAuthorized>
</AuthorizeView>

@code{

private List<ResponsibilityAreaDTO> ResponsibilityAreaList { get; set; } = new List<ResponsibilityAreaDTO>();

    // Page initialization 
    protected override async Task OnInitializedAsync()
    {
        await LoadResponsibilityAreas();
    }

    // Data loading method for responsibility areas
    private async Task LoadResponsibilityAreas()
    {
        try
        {
            List<ResponsibilityAreaDTO>? areas = await ApiService.GetListAsync<ResponsibilityAreaDTO>("api/responsibilityarea") ?? new ();
            ResponsibilityAreaList = areas.ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fejl ved indlæsning af ansvarsområder: {ex.Message}", Severity.Error);
        }
    }

    // Filter responsibility areas based on date
        // Filter properties and methods
    private DateTime? _selectedFilterDate = null;

    private List<ResponsibilityAreaDTO> GetFilteredResponsibilityAreas()
    {
        if (!_selectedFilterDate.HasValue)
        {
            return ResponsibilityAreaList;
        }
        
        // Filters the list for the selected data and returns it. If no items are found, an info snackbar is shown
        List<ResponsibilityAreaDTO>? filtered = ResponsibilityAreaList
            .Where(r => r.Date.Date == _selectedFilterDate.Value.Date)
            .ToList();

        if (filtered.Count == 0)
            Snackbar.Add("Ingen ansvarsområder fundet for den valgte dato.", Severity.Info);
            
        return filtered;
    }

    
    private void ClearFilter()
    {
        _selectedFilterDate = null;
    }

    private void NavigateToCreatePage(){
        NavigationManager.NavigateTo("/admin/responsibility-area");
    }

}