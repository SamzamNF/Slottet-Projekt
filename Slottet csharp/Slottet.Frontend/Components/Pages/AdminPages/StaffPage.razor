@page "/admin/staff"
@rendermode InteractiveServer
@using MudBlazor
@using Slottet.Shared.DTO;
@using Microsoft.AspNetCore.Authorization

@inject ApiService ApiService
@inject ISnackbar Snackbar


@attribute [Authorize(Roles = "Admin")]

<PageTitle>Administrer personale</PageTitle>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-brand-matcha m-0">Medarbejder Administration</h2>
    </div>

    @* Filtering buttons for each department, made from button component *@
    <label class="form-label fw-bold text-brand-matcha mb-2">Filtrer efter afdeling:</label>
    
    <div class="d-flex gap-2 mb-3 px-1">
        <Button Variant="@(_selectedDepartment == "Alle" ? BrandButtonType.Matcha : BrandButtonType.Success)"
                OnClick='() => SetFilter("Alle")'
                VariableText="Alle"/>
        
        <Button Variant="@(_selectedDepartment == "Slottet" ? BrandButtonType.Matcha : BrandButtonType.Success)"
                OnClick='() => SetFilter("Slottet")'
                VariableText="Slottet"/>

        <Button Variant="@(_selectedDepartment == "Skoven" ? BrandButtonType.Matcha : BrandButtonType.Success)"
                OnClick='() => SetFilter("Skoven")'
                VariableText="Skoven"/>
    </div>
    
    @* EventCallBacks (OnAdd, OnEdit, OnDelete, handles passing the item as a parameter, in the component)*@
    <Table TItem="StaffDto" 
                  Items="@FilteredStaff()" 
                  AddButtonText="Opret Medarbejder"
                  OnAdd="HandleAdd" 
                  OnEdit="HandleEdit" 
                  OnDelete="HandleDelete"
                  PageSize="10">
        
        <TableHeader>
            <th>Initialer</th>
            <th>Navn</th>
            <th>Email</th>
            <th>Afdeling</th>
            <th>Rolle</th>
        </TableHeader>

        <RowTemplate Context="staff">
            <td class="fw-bold text-brand-matcha">@staff.Initials</td>
            <td>@staff.FirstName @staff.LastName</td>
            <td>@staff.Email</td>
            <td>
                <span class="badge bg-brand-owl text-dark">@staff.Department</span>
            </td>
            <td>@staff.RoleName</td>
        </RowTemplate>

    </Table>

    @* Modal component for adding/editing/deleting staff members *@
    <Modal Title="@modalTitle" 
           Show="@showModal" 
           OnClose="CloseModal" 
           OnAction="HandleModalConfirm"
           SaveButtonText="@modalButtonText"
           SaveButtonVariant="@saveButtonVariant"
           SizeClass="@modalSize">
        
        @* If IsDeleteMode is true, show delete confirmation *@
        @if (isDeleteMode)
        {
            <div class="text-center p-3">
                <i class="bi bi-exclamation-octagon text-danger display-4"></i>
                <p class="mt-3">Er du sikker på, at du vil slette <b>@currentStaff.FirstName @currentStaff.LastName</b>?</p>
            </div>
        }
        @* If DeleteMode is false, show the form for adding/editing staff *@
        else
        {
            <div class="row g-3">
                <div class="col-md-6">
                    <label class="form-label fw-bold text-brand-matcha">Fornavn</label>
                    <input type="text" class="form-control" @bind="currentStaff.FirstName" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-brand-matcha">Efternavn</label>
                    <input type="text" class="form-control" @bind="currentStaff.LastName" />
                </div>
                <div class="col-md-4">
                    <label class="form-label fw-bold text-brand-matcha">Initialer</label>
                    <input type="text" class="form-control" @bind="currentStaff.Initials" />
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-bold text-brand-matcha">Email</label>
                    <input type="email" class="form-control" @bind="currentStaff.Email" />
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-brand-matcha">Afdeling</label>
                    <select class="form-select" @bind="currentStaff.DepartmentId">
                        <option value="">Vælg afdeling...</option>
                        @* Shows the Department NAMES, but stores the ID *@
                        @foreach (DepartmentDTO dept in DepartmentOptions)
                        {
                            <option value="@dept.Id">@dept.DepartmentName</option>
                        }
                    </select>
                </div>
                <div class="col-md-6">
                    <label class="form-label fw-bold text-brand-matcha">Rolle</label>
                    <select class="form-select" @bind="currentStaff.RoleId">
                        <option value="">Vælg rolle...</option>
                        @* Shows the Role NAMES, but stores the ID *@
                        @foreach (RoleDTO role in RoleOptions)
                        {
                            <option value="@role.Id">@role.RoleName</option>
                        }
                    </select>
                </div>
            </div>
        }
        
        
    </Modal>
</div>

@code {

    // List for Staff and Role Options & Department Options
    private List<StaffDto> StaffList = new();
    private List<RoleDTO> RoleOptions = new();
    private List<DepartmentDTO> DepartmentOptions = new();

    // String to hold selected department for filtering staff members
    private string _selectedDepartment = "Alle";
    
    
    // Modal variables and methods for handling add/edit/delete staff members
    private bool showModal = false;
    private string modalTitle = "";
    private StaffDto currentStaff = new StaffDto();
    private string modalButtonText = "";
    private bool isDeleteMode = false;
    private string modalSize = "";
    private BrandButtonType saveButtonVariant = BrandButtonType.Matcha;
    
    
    // Initialize page with mock data, later fetch from API
    protected override async Task OnInitializedAsync()
    {
        try
        {
            RoleOptions = await ApiService.GetListAsync<RoleDTO>("api/role") ?? new();
            DepartmentOptions = await ApiService.GetListAsync<DepartmentDTO>("api/department") ?? new();
            StaffList = await ApiService.GetListAsync<StaffDto>("api/staff") ?? new();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Fejl ved hentning af dataa: {ex.Message}");
        }      

    }

    // Modal for adding, which sets the dynamic content of the modal to empty, and changes the CTA button to save instead of delete
    private void HandleAdd()
    {
        currentStaff = new StaffDto(); // Clear current staff data
        modalTitle = "Opret Medarbejder";
        modalButtonText = "Gem Medarbejder";
        saveButtonVariant = BrandButtonType.Matcha;
        isDeleteMode = false;
        modalSize = "modal-lg";
        showModal = true;
    }

    // Modal for editing, which sets the dynamic content of the modal to the selected objects data, and changes the CTA button to save instead of delete
    private void HandleEdit(StaffDto staff)
    {
        // Load selected staff data into modal
        currentStaff = new StaffDto
        {
            Id = staff.Id,
            Initials = staff.Initials,
            FirstName = staff.FirstName,
            LastName = staff.LastName,
            Email = staff.Email,
            DepartmentId = staff.DepartmentId,
            RoleId = staff.RoleId,
        };

        modalTitle = "Rediger Medarbejder";
        modalButtonText = "Gem Medarbejder";
        saveButtonVariant = BrandButtonType.Matcha;
        modalSize = "modal-lg";
        isDeleteMode = false;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    // Modal for deleting, which sets the dynamic content of the modal to a delete confirmation, and changes the CTA button to delete instead of save
    private async Task HandleDelete(StaffDto staff)
    {
        currentStaff = staff;

        modalTitle = "Bekræft Sletning";
        modalButtonText = "Slet Medarbejder";
        saveButtonVariant = BrandButtonType.Danger;
        isDeleteMode = true;
        modalSize = "modal-md";
        showModal = true;       
    }
    // Method that changes whether the modals CTA button should delete or add/edit
    private async Task HandleModalConfirm()
    {
        if (isDeleteMode)
        {
            await DeleteStaff();
        }
        else
        {
            await SaveStaff(); // Kald gem-logik
        }
    }

    // API calls

    // Method to create a new staff member, or update an existing staff member based on the ID of the currentStaff object, and then refresh the staff list from the API
    private async Task SaveStaff()
    {
        try
        {
            // Creates a new staff member, if the ID is 0
            if (currentStaff.Id == 0)
            {
                StaffDto? createdStaff = await ApiService.PostAsync<StaffDto, StaffDto>("api/staff", currentStaff);

                if (createdStaff != null)
                {
                    StaffList.Add(createdStaff);
                }
                Snackbar.Add($"Medarbejder {createdStaff?.FirstName} {createdStaff?.LastName} oprettet succesfuldt.", Severity.Success);
            }
            // Updates an existing staff member, if the ID is not 0
            else
            {
                await ApiService.PutAsync($"api/staff", currentStaff);

                var updatedStaff = await ApiService.GetAsync<StaffDto>($"api/staff/{currentStaff.Id}");
                
                if (updatedStaff != null)
                {
                    int index = StaffList.FindIndex(s => s.Id == currentStaff.Id);
                    if (index != -1)
                    {
                        StaffList[index] = updatedStaff;
                    }
                }

                Snackbar.Add($"Medarbejder {currentStaff.FirstName} {currentStaff.LastName} opdateret succesfuldt.", Severity.Success);
            }

            showModal = false; // Close modal after saving
            StateHasChanged(); // Refresh UI
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fejl ved gemning af medarbejder: {ex.Message}", Severity.Error);
        }
    }
    private async Task DeleteStaff()
    {
        try
        {
            await ApiService.DeleteAsync($"api/staff/{currentStaff.Id}");

            StaffList.RemoveAll(s => s.Id == currentStaff.Id);

            Snackbar.Add($"{currentStaff.FirstName} {currentStaff.LastName} er slettet.", Severity.Success);
            showModal = false;
            StateHasChanged(); // Refresh UI
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fejl ved sletning af medarbejder: {ex.Message}", Severity.Error);
        }
    }

    // Filtered list for "StaffDto" based on input and string to store the selected filter value
        private List<StaffDto> FilteredStaff()
    {
        return _selectedDepartment == "Alle" ? StaffList : StaffList.Where(s => s.Department == _selectedDepartment).ToList();
    }
    private void SetFilter(string department)
    {
        _selectedDepartment = department;
    }

}
