@page "/admin/department"
@rendermode InteractiveServer
@using MudBlazor
@using Slottet.Shared.DTO;
@using Microsoft.AspNetCore.Authorization

@inject ApiService ApiService
@inject ISnackbar Snackbar


@attribute [Authorize(Roles = "Admin")]

<PageTitle>Administrer afdelinger</PageTitle>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-brand-matcha m-0">Afdelings Administration</h2>
    </div>

    
    @*  EventCallBacks (OnAdd, OnEdit, OnDelete, handles passing the item as a parameter, in the component)*@
    <Table TItem="DepartmentDTO" 
                  Items="DepartmentList" 
                  AddButtonText="Opret Afdeling"
                  OnAdd="HandleAdd" 
                  OnEdit="HandleEdit" 
                  OnDelete="HandleDelete"
                  PageSize="10">
        
        <TableHeader>
            <th style="width: 400px;">Id</th>
            <th>Afdelingsnavn</th>
        </TableHeader>

        <RowTemplate Context="dept">
            <td>
                <span class="badge bg-brand-owl text-dark">@dept.Id</span>
            </td>
            <td>@dept.DepartmentName</td>
        </RowTemplate>

    </Table>

    @* Modal component for adding/editing/deleting departments *@
    <Modal Title="@modalTitle" 
           Show="@showModal" 
           OnClose="CloseModal" 
           OnAction="HandleModalConfirm"
           SaveButtonText="@modalButtonText"
           SaveButtonVariant="@saveButtonVariant"
           SizeClass="@modalSize">
        
        @* If IsDeleteMode is true, show delete confirmation *@
        @if (isDeleteMode)
        {
            <div class="text-center p-3">
                <i class="bi bi-exclamation-octagon text-danger display-4"></i>
                <p class="mt-3">Er du sikker på, at du vil slette <b>@currentDepartment.DepartmentName</b>?</p>
            </div>
        }
        @* If DeleteMode is false, show the form for adding/editing departments *@
        else
        {
            <div class="row g-3">
                <div class="col-md-12">
                    <label class="form-label fw-bold text-brand-matcha">Afdelingsnavn</label>
                    <input type="text" class="form-control" @bind="currentDepartment.DepartmentName" />
                </div>
            </div>
        }
        
        
    </Modal>
</div>

@code {

    // List for Departments
    private List<DepartmentDTO> DepartmentList = new();

    
    // Modal variables and methods for handling add/edit/delete departments
    private bool showModal = false;
    private string modalTitle = "";
    private DepartmentDTO currentDepartment = new DepartmentDTO();
    private string modalButtonText = "";
    private bool isDeleteMode = false;
    private string modalSize = "";
    private BrandButtonType saveButtonVariant = BrandButtonType.Matcha;
    
    
    // Initialize page with mock data, later fetch from API
    protected override async Task OnInitializedAsync()
    {
        try
        {
            DepartmentList = await ApiService.GetListAsync<DepartmentDTO>("api/department") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fejl ved hentning af data: {ex.Message}", Severity.Error);
        }      

    }

    // Modal for adding, which sets the dynamic content of the modal to empty, and changes the CTA button to save instead of delete
    private void HandleAdd()
    {
        currentDepartment = new DepartmentDTO(); // Clear current department data
        modalTitle = "Opret Afdeling";
        modalButtonText = "Gem Afdeling";
        saveButtonVariant = BrandButtonType.Matcha;
        isDeleteMode = false;
        modalSize = "modal-lg";
        showModal = true;
    }

    // Modal for editing, which sets the dynamic content of the modal to the selected objects data, and changes the CTA button to save instead of delete
    private void HandleEdit(DepartmentDTO dept)
    {
        // Load selected department data into modal
        currentDepartment = new DepartmentDTO
        {
            Id = dept.Id,
            DepartmentName = dept.DepartmentName,
        };

        modalTitle = "Rediger Afdeling";
        modalButtonText = "Gem Afdeling";
        saveButtonVariant = BrandButtonType.Matcha;
        modalSize = "modal-lg";
        isDeleteMode = false;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    // Modal for deleting, which sets the dynamic content of the modal to a delete confirmation, and changes the CTA button to delete instead of save
    private async Task HandleDelete(DepartmentDTO dept)
    {
        currentDepartment = dept; // Load selected department data into modal for reference in confirmation message

        modalTitle = "Bekræft Sletning";
        modalButtonText = "Slet Afdeling";
        saveButtonVariant = BrandButtonType.Danger;
        isDeleteMode = true;
        modalSize = "modal-md";
        showModal = true;

        
    }
    // Method that changes whether the modals CTA button should delete or add/edit
    private async Task HandleModalConfirm()
    {
        if (isDeleteMode)
        {
            await DeleteDepartment();
        }
        else
        {
            await SaveDepartment(); // Kald gem-logik
        }
    }

    // API calls

    // Method to create a new department, or update an existing department based on the ID of the currentDepartment object, and then refresh the department list from the API
    private async Task SaveDepartment()
    {
        try
        {
            // Creates a new department, if the ID is 0
            if (currentDepartment.Id == 0)
            {
                DepartmentDTO? createdDepartment = await ApiService.PostAsync<DepartmentDTO, DepartmentDTO>("api/department", currentDepartment);

                if (createdDepartment != null)
                {
                    DepartmentList.Add(createdDepartment);
                }
                Snackbar.Add($"Afdeling {createdDepartment?.DepartmentName} oprettet succesfuldt.", Severity.Success);
            }
            // Updates an existing department, if the ID is not 0
            else
            {
                await ApiService.PutAsync($"api/department", currentDepartment);

                var updatedDepartment = await ApiService.GetAsync<DepartmentDTO>($"api/department/{currentDepartment.Id}");

                if (updatedDepartment != null)
                {
                    int index = DepartmentList.FindIndex(d => d.Id == currentDepartment.Id);
                    if (index != -1)
                    {
                        DepartmentList[index] = updatedDepartment;
                    }
                }

                Snackbar.Add($"Afdeling {currentDepartment.DepartmentName} opdateret succesfuldt.", Severity.Success);
            }

            showModal = false; // Close modal after saving
            StateHasChanged(); // Refresh UI
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fejl ved gemning af afdeling: {ex.Message}", Severity.Error);
        }
    }
    private async Task DeleteDepartment()
    {
        try
        {
            await ApiService.DeleteAsync($"api/department/{currentDepartment.Id}");

            DepartmentList.RemoveAll(d => d.Id == currentDepartment.Id);

            Snackbar.Add($"{currentDepartment.DepartmentName} er slettet.", Severity.Success);
            showModal = false;
            StateHasChanged(); // Refresh UI
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fejl ved sletning af medarbejder: {ex.Message}", Severity.Error);
        }
    }


}
