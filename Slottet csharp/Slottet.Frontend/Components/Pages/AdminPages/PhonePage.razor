@page "/admin/phone"
@rendermode InteractiveServer
@using MudBlazor
@using Slottet.Shared.DTO;
@using Microsoft.AspNetCore.Authorization

@inject ApiService ApiService
@inject ISnackbar Snackbar


@attribute [Authorize(Roles = "Admin")]

<PageTitle>Administrer telefoner</PageTitle>

<div class="container mt-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="text-brand-matcha m-0">Telefon Administration</h2>
    </div>

    
    @*  EventCallBacks (OnAdd, OnEdit, OnDelete, handles passing the item as a parameter, in the component)*@
    <Table TItem="PhoneDTO" 
                  Items="PhoneList" 
                  AddButtonText="Opret Telefon"
                  OnAdd="HandleAdd" 
                  OnEdit="HandleEdit" 
                  OnDelete="HandleDelete"
                  PageSize="10">
        
        <TableHeader>
            <th style="width: 400px;">Id</th>
            <th>Telefonnummer</th>
        </TableHeader>

        <RowTemplate Context="phone">
            <td>
                <span class="badge bg-brand-owl text-dark">@phone.Id</span>
            </td>
            <td>@phone.PhoneNumber</td>
        </RowTemplate>

    </Table>

    @* Modal component for adding/editing/deleting phones *@
    <Modal Title="@modalTitle" 
           Show="@showModal" 
           OnClose="CloseModal" 
           OnAction="HandleModalConfirm"
           SaveButtonText="@modalButtonText"
           SaveButtonVariant="@saveButtonVariant"
           SizeClass="@modalSize">
        
        @* If IsDeleteMode is true, show delete confirmation *@
        @if (isDeleteMode)
        {
            <div class="text-center p-3">
                <i class="bi bi-exclamation-octagon text-danger display-4"></i>
                <p class="mt-3">Er du sikker på, at du vil slette <b>@currentPhone.PhoneNumber</b>?</p>
            </div>
        }
        @* If DeleteMode is false, show the form for adding/editing departments *@
        else
        {
            <div class="row g-3">
                <div class="col-md-12">
                    <label class="form-label fw-bold text-brand-matcha">Telefonnummer</label>
                    <input type="text" class="form-control" @bind="currentPhone.PhoneNumber" />
                </div>
            </div>
        }
        
        
    </Modal>
</div>

@code {

    // List for Phones
    private List<PhoneDTO> PhoneList = new();

    
    // Modal variables and methods for handling add/edit/delete phones
    private bool showModal = false;
    private string modalTitle = "";
    private PhoneDTO currentPhone = new PhoneDTO();
    private string modalButtonText = "";
    private bool isDeleteMode = false;
    private string modalSize = "";
    private BrandButtonType saveButtonVariant = BrandButtonType.Matcha;
    
    
    // Initialize page with API data
    protected override async Task OnInitializedAsync()
    {
        try
        {
            PhoneList = await ApiService.GetListAsync<PhoneDTO>("api/phone") ?? new();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fejl ved hentning af data: {ex.Message}", Severity.Error);
        }      

    }

    // Modal for adding, which sets the dynamic content of the modal to empty, and changes the CTA button to save instead of delete
    private void HandleAdd()
    {
        currentPhone = new PhoneDTO(); // Clear current phone data
        modalTitle = "Opret Telefon";
        modalButtonText = "Gem Telefon";
        saveButtonVariant = BrandButtonType.Matcha;
        isDeleteMode = false;
        modalSize = "modal-lg";
        showModal = true;
    }

    // Modal for editing, which sets the dynamic content of the modal to the selected objects data, and changes the CTA button to save instead of delete
    private void HandleEdit(PhoneDTO phone)
    {
        // Load selected phone data into modal
        currentPhone = new PhoneDTO
        {
            Id = phone.Id,
            PhoneNumber = phone.PhoneNumber
        };

        modalTitle = "Rediger Telefon";
        modalButtonText = "Gem Telefon";
        saveButtonVariant = BrandButtonType.Matcha;
        modalSize = "modal-lg";
        isDeleteMode = false;
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
    }

    // Modal for deleting, which sets the dynamic content of the modal to a delete confirmation, and changes the CTA button to delete instead of save
    private async Task HandleDelete(PhoneDTO phone)
    {
        currentPhone = phone; // Load selected phone data into modal for reference in confirmation message

        modalTitle = "Bekræft Sletning";
        modalButtonText = "Slet Telefon";
        saveButtonVariant = BrandButtonType.Danger;
        isDeleteMode = true;
        modalSize = "modal-md";
        showModal = true;

        
    }
    // Method that changes whether the modals CTA button should delete or add/edit
    private async Task HandleModalConfirm()
    {
        if (isDeleteMode)
        {
            await DeletePhone();
        }
        else
        {
            await SavePhone();
        }
    }

    // API calls

    // Method to create a new phone, or update an existing phone based on the ID of the currentPhone object, and then refresh the phone list from the API
    private async Task SavePhone()
    {
        try
        {
            // Creates a new phone, if the ID is 0
            if (currentPhone.Id == 0)
            {
                PhoneDTO? createdPhone = await ApiService.PostAsync<PhoneDTO, PhoneDTO>("api/phone", currentPhone);

                if (createdPhone != null)
                {
                    PhoneList.Add(createdPhone);
                }
                Snackbar.Add($"Telefon {createdPhone?.PhoneNumber} oprettet succesfuldt.", Severity.Success);
            }
            // Updates an existing phone, if the ID is not 0
            else
            {
                await ApiService.PutAsync($"api/phone", currentPhone);

                var updatedPhone = await ApiService.GetAsync<PhoneDTO>($"api/phone/{currentPhone.Id}");

                if (updatedPhone != null)
                {
                    int index = PhoneList.FindIndex(p => p.Id == currentPhone.Id);
                    if (index != -1)
                    {
                        PhoneList[index] = updatedPhone;
                    }
                }

                Snackbar.Add($"Telefon {currentPhone.PhoneNumber} opdateret succesfuldt.", Severity.Success);
            }

            showModal = false; // Close modal after saving
            StateHasChanged(); // Refresh UI
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fejl ved gemning af telefon: {ex.Message}", Severity.Error);
        }
    }
    private async Task DeletePhone()
    {
        try
        {
            await ApiService.DeleteAsync($"api/phone/{currentPhone.Id}");

            PhoneList.RemoveAll(p => p.Id == currentPhone.Id);

            Snackbar.Add($"{currentPhone.PhoneNumber} er slettet.", Severity.Success);
            showModal = false;
            StateHasChanged(); // Refresh UI
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Fejl ved sletning af telefon: {ex.Message}", Severity.Error);
        }
    }


}
