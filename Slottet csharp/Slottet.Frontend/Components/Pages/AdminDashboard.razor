@page "/admin-dashboard"
@rendermode InteractiveServer

@using Microsoft.AspNetCore.Authorization
@attribute [Authorize(Roles = "Admin")]

<PageTitle>Admin dashboard</PageTitle>

<div class="container">
    <div class="row g-3 mt-4">
        <Card
            Title="Beboer"
            Header="Administrer beboere"
            Text=@("Opret, rediger og slet beboere i systemet og hold styr på deres stamdata. \n\nFå et hurtigt overblik over den enkelte beboer og hold stamdataene helt opdaterede")
            ButtonText="Se mere"
            Link="counter"
            Color="bg-brand-beige"
            TextClass="text-dark"
            ButtonVariant="BrandButtonType.Matcha" />

        <Card
            Title="Personale"
            Header="Administrer personale"
            Text=@("Opret, rediger og slet personale i systemet og hold styr på deres stamdata. \n\nFå et hurtigt overblik over den enkelte medarbejder, deres rolle og afdeling.")
            ButtonText="Se mere"
            Link="admin/staff"
            Color="bg-brand-beige"
            TextClass="text-dark"
            ButtonVariant="BrandButtonType.Matcha" />

        <Card
            Title="Afdelinger"
            Header="Administrer afdelinger"
            Text=@("Opret, rediger og slet afdelinger i systemet. \n\nFå et hurtigt overblik over de enkelte afdelinger.")
            ButtonText="Se mere"
            Link="admin/department"
            Color="bg-brand-beige"
            TextClass="text-dark"
            ButtonVariant="BrandButtonType.Matcha" />

        <Card
            Title="Ansvarsområder"
            Header="Administrer ansvarsområder"
            Text=@("Opret, rediger og slet ansvarsområder i systemet og hold styr på de daglige ansvarlige. \n\nFå et hurtigt overblik over de enkelte ansvarsområder og deres ansvarlige medarbejdere.")
            ButtonText="Se mere"
            Link="admin/responsibility-area"
            Color="bg-brand-beige"
            TextClass="text-dark"
            ButtonVariant="BrandButtonType.Matcha" />

        <Card
            Title="Roller"
            Header="Administrer roller"
            Text=@("Opret, rediger og slet roller i systemet og hold styr på de forskellige roller. \n\nFå et hurtigt overblik over de enkelte roller.")
            ButtonText="Se mere"
            Link="admin/role"
            Color="bg-brand-beige"
            TextClass="text-dark"
            ButtonVariant="BrandButtonType.Matcha" />
        
        <Card
            Title="Post It"
            Header="Administrer post-its"
            Text=@("Opret, rediger og slet post-its i systemet og hold styr på deres indhold. \n\nFå et hurtigt overblik over alle post-its i systemet.")
            ButtonText="Se mere"
            Link="counter"
            Color="bg-brand-beige"
            TextClass="text-dark"
            ButtonVariant="BrandButtonType.Matcha" />

        <Card
            Title="Telefoner"
            Header="Administrer telefoner"
            Text=@("Opret, rediger og slet telefoner i systemet. \n\nFå et hurtigt overblik over alle telefoner i systemet.")
            ButtonText="Se mere"
            Link="admin/phone"
            Color="bg-brand-beige"
            TextClass="text-dark"
            ButtonVariant="BrandButtonType.Matcha" />
    </div> 
</div>

