@page "/test-claims"
@using Microsoft.AspNetCore.Components.Authorization

<h3>Diagnose: Mine Rettigheder</h3>

<AuthorizeView>
    <Authorized>
        <p>Du er logget ind som: <b>@context.User.Identity?.Name</b></p>
        
        <h4>Dine claims fra Entra ID:</h4>
        <table class="table table-bordered table-sm">
            <thead>
                <tr>
                    <th>Type</th>
                    <th>Værdi</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var claim in context.User.Claims)
                {
                    <tr>
                        <td>@claim.Type</td>
                        <td>@claim.Value</td>
                    </tr>
                }
            </tbody>
        </table>
    </Authorized>
    <NotAuthorized>
        <p>Du er ikke logget ind.</p>
    </NotAuthorized>
</AuthorizeView>