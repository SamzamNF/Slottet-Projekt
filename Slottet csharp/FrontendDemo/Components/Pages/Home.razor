@page "/"
@rendermode InteractiveServer

<PageTitle>Østruplund Overlapsskema</PageTitle>

<nav class="navbar navbar-dark bg-dark mb-4 shadow-sm">
    <div class="container-fluid">
        <span class="navbar-brand h1 mb-0">Østruplund Overlapsskema</span>
        <div class="d-flex align-items-center text-white">
            <span class="me-3">Logget ind som: <strong>Personale A</strong></span>
            <button class="btn btn-outline-light btn-sm">Log ud</button>
        </div>
    </div>
</nav>

<div class="container-fluid px-4 pb-5">

    <div class="d-flex justify-content-between align-items-center bg-light mb-4 rounded p-3">
        <button class="btn btn-primary px-3 py-2 shadow-sm" @onclick="PreviousDay" aria-label="Forrige dag">
            <i class="bi bi-chevron-left fs-4"></i>
        </button>

        <h3 class="fw-bold fs-5 fs-sm-3 mb-0 text-center">@currentDate.ToString("dd. MMMM yyyy")</h3>

        <button class="btn btn-primary px-3 py-2 shadow-sm" @onclick="NextDay" disabled="@(currentDate >= DateTime.Today)" aria-label="Næste dag">
            <i class="bi bi-chevron-right fs-4"></i>
        </button>
    </div>

    <ul class="nav custom-tabs mb-4 flex-nowrap">
        <li class="nav-item flex-grow-1 flex-md-grow-0 me-1 text-center">
            <a class="nav-link text-dark px-sm-5 py-sm-3 fs-6 fs-sm-5 px-2 py-2 @(activeDepartment == "Slottet" ? "active fw-bold" : "")"
               @onclick='() => ChangeDepartment("Slottet")'>
                Slottet <span class="badge bg-secondary ms-sm-2 ms-1">@Residents.Count(r => r.Department == "Slottet")</span>
            </a>
        </li>
        <li class="nav-item flex-grow-1 flex-md-grow-0 text-center">
            <a class="nav-link text-dark px-sm-5 py-sm-3 fs-6 fs-sm-5 px-2 py-2 @(activeDepartment == "Skoven" ? "active fw-bold" : "")"
               @onclick='() => ChangeDepartment("Skoven")'>
                Skoven <span class="badge bg-secondary ms-sm-2 ms-1">@Residents.Count(r => r.Department == "Skoven")</span>
            </a>
        </li>
    </ul>

    <div class="row g-4">
        @foreach (var resident in ActiveResidents)
        {
            <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                <div class="card h-100 resident-card overflow-hidden border-0 shadow" style="cursor: pointer" @onclick="() => OpenResidentModal(resident)">
                    <div class="@GetRiskBgColor(resident.RiskLevel)" style="height: 20px; width: 100%;"></div>

                    <div class="card-body">
                        <h4 class="card-title fw-bold mb-3">@resident.Initials</h4>

                        <div class="mb-2">
                            <strong>Personale:</strong>
                            @string.Join(", ", resident.Caretakers)
                        </div>
                        <div class="mb-2">
                            <strong>Humør:</strong> @resident.Mood
                        </div>
                        <div class="mb-3">
                            <strong>Medicin / PN:</strong>
                            <ul class="list-unstyled mb-0">
                                @foreach (var med in resident.Medications)
                                {
                                    <li class="small mb-1">
                                        <i class="bi bi-check-circle-fill text-primary me-1"></i> @med.Time - @med.Description
                                    </li>
                                }
                            </ul>
                        </div>
                        <hr />
                        <p class="card-text small text-muted line-clamp-2" title="@resident.Note">
                            @resident.Note
                        </p>
                    </div>

                    <div class="card-footer border-top-0 text-muted small d-flex justify-content-between align-items-center bg-white pb-3">
                        <span>Ændret: @resident.LastEditedTime.ToString("HH:mm") af @resident.LastEditedBy</span>
                        <a href="#" @onclick:preventDefault class="text-decoration-none">Vis log</a>
                    </div>
                </div>
            </div>
        }
    </div>

</div>

@if (selectedResident != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header @GetRiskBgColor(selectedResident.RiskLevel) border-0 text-white">
                    <h5 class="modal-title">Rediger Borger: @selectedResident.Initials</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Risikovurdering</label>
                            <select class="form-select" @bind="selectedResident.RiskLevel">
                                <option value="Green">Fredelig (Grøn)</option>
                                <option value="Yellow">Utilregnelig (Gul)</option>
                                <option value="Red">Farlig (Rød)</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-bold">Humør</label>
                            <select class="form-select" @bind="selectedResident.Mood">
                                <option value="Glad">Glad</option>
                                <option value="Neutral">Neutral</option>
                                <option value="Ked af det">Ked af det</option>
                                <option value="Sur/Udadreagerende">Sur/Udadreagerende</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Fritekst (Aktiviteter, info, m.m.)</label>
                        <textarea class="form-control" rows="4" @bind="selectedResident.Note"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Medicin og PN tiltag</label>
                        <ul class="list-group mb-2">
                            @foreach (var med in selectedResident.Medications)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@med.Time - @med.Description</span>
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </li>
                            }
                        </ul>
                        <button class="btn btn-sm btn-outline-primary">+ Tilføj medicin/PN</button>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between border-top-0 bg-light">
                    <span class="text-muted small">Log: Senest redigeret @selectedResident.LastEditedTime.ToString("HH:mm")</span>
                    <div>
                        <button type="button" class="btn-secondary btn" @onclick="CloseModal">Annuller</button>
                        <button type="button" class="btn-success btn" @onclick="SaveChanges">Gem ændringer</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .resident-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .resident-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
        }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .custom-tabs {
        border-bottom: 1px solid var(--bs-border-color);
    }

        .custom-tabs .nav-link {
            cursor: pointer;
            background-color: var(--bs-light);
            border: 1px solid var(--bs-border-color);
            margin-bottom: -1px;
            border-radius: 0.375rem 0.375rem 0 0;
        }

            .custom-tabs .nav-link:hover {
                background-color: #e9ecef;
            }

            .custom-tabs .nav-link.active {
                background-color: #fff;
                border-bottom-color: #fff;
            }
</style>

@code {
    private DateTime currentDate = DateTime.Today;
    private string activeDepartment = "Slottet";
    private Resident? selectedResident;

    public class Resident
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Initials { get; set; } = "";
        public string Department { get; set; } = "";
        public string RiskLevel { get; set; } = "Green";
        public List<string> Caretakers { get; set; } = new();
        public string Mood { get; set; } = "Neutral";
        public string Note { get; set; } = "";
        public List<MedicationTask> Medications { get; set; } = new();
        public DateTime LastEditedTime { get; set; }
        public string LastEditedBy { get; set; } = "";
    }

    public class MedicationTask
    {
        public string Time { get; set; } = "";
        public string Description { get; set; } = "";
    }

    private List<Resident> Residents = new();
    private IEnumerable<Resident> ActiveResidents => Residents.Where(r => r.Department == activeDepartment);

    protected override void OnInitialized()
    {
        GenerateDummyData();
    }

    private void PreviousDay() => currentDate = currentDate.AddDays(-1);

    private void NextDay()
    {
        if (currentDate < DateTime.Today) currentDate = currentDate.AddDays(1);
    }

    private void ChangeDepartment(string dept) => activeDepartment = dept;

    private void OpenResidentModal(Resident resident)
    {
        selectedResident = resident;
    }

    private void CloseModal() => selectedResident = null;

    private void SaveChanges()
    {
        if (selectedResident != null)
        {
            selectedResident.LastEditedTime = DateTime.Now;
            selectedResident.LastEditedBy = "Personale A";
        }
        CloseModal();
    }

    private string GetRiskBgColor(string riskLevel) => riskLevel switch
    {
        "Red" => "bg-danger",
        "Yellow" => "bg-warning",
        "Green" => "bg-success",
        _ => "bg-secondary"
    };

    private void GenerateDummyData()
    {
        var random = new Random();
        string[] moods = { "Glad", "Neutral", "Ked af det", "Sur/Udadreagerende" };
        string[] risks = { "Green", "Green", "Green", "Yellow", "Yellow", "Red" };
        string[] caretakerNames = { "Jens H.", "Maria K.", "Søren P.", "Line N." };

        for (int i = 1; i <= 9; i++)
        {
            Residents.Add(CreateRandomResident($"B{i}", "Slottet", random, moods, risks, caretakerNames));
        }

        for (int i = 10; i <= 21; i++)
        {
            Residents.Add(CreateRandomResident($"B{i}", "Skoven", random, moods, risks, caretakerNames));
        }
    }

    private Resident CreateRandomResident(string initials, string dept, Random rnd, string[] moods, string[] risks, string[] caretakers)
    {
        int caretakerCount = rnd.Next(1, 3);
        var assignedCaretakers = caretakers.OrderBy(x => rnd.Next()).Take(caretakerCount).ToList();

        string noteText = rnd.Next(0, 2) == 0
            ? "Gik en tur i parken formiddag. Skal have hævet lommepenge til weekenden."
            : "Meget urolig til morgen. Har afvist at spise morgenmad og har haft behov for skærmning. Vi har forsøgt at tilbyde et bad, men det ønskede borgeren ikke. Fortsat observation nødvendig op ad dagen, da der kan være risiko for konflikt.";

        return new Resident
        {
            Initials = initials,
            Department = dept,
            RiskLevel = risks[rnd.Next(risks.Length)],
            Mood = moods[rnd.Next(moods.Length)],
            Caretakers = assignedCaretakers,
            Note = noteText,
            LastEditedTime = DateTime.Today.AddHours(rnd.Next(7, 14)).AddMinutes(rnd.Next(0, 59)),
            LastEditedBy = caretakers[rnd.Next(caretakers.Length)],
            Medications = new List<MedicationTask>
            {
                new() { Time = "08:00", Description = "Morgenmedicin" },
                new() { Time = "12:00", Description = "Påføring af creme" }
            }
        };
    }
}