@page "/admin"
@rendermode InteractiveServer

<PageTitle>Østruplund Overlapsskema - Admin</PageTitle>

<div class="d-flex flex-column min-vh-100">
    <nav class="navbar navbar-dark bg-dark shadow-sm">
        <div class="container-fluid">
            <span class="navbar-brand h1 mb-0">Østruplund Overlapsskema</span>
            <div class="d-flex align-items-center text-white">
                <span class="me-3">Logget ind som: <strong>Administrator</strong></span>
                <button class="btn btn-outline-light btn-sm">Log ud</button>
            </div>
        </div>
    </nav>

    <div class="bg-secondary d-flex justify-content-center mb-4 gap-3 p-2 text-white shadow-sm">
        <span class="fw-bold align-self-center me-2"><i class="bi bi-shield-lock-fill me-1"></i> Admin Panel:</span>
        <button class="btn btn-sm btn-light" @onclick="NotImplementedAlert"><i class="bi bi-people-fill me-1"></i> Håndtér Personale</button>
        <button class="btn btn-sm btn-light" @onclick="NotImplementedAlert"><i class="bi bi-person-gear me-1"></i> Håndtér Systembrugere</button>
    </div>

    <div class="container-fluid flex-grow-1 px-4 pb-5">

        <div class="d-flex justify-content-between align-items-center bg-light mb-4 rounded p-3">
            <button class="btn btn-primary px-3 py-2 shadow-sm" @onclick="PreviousDay" aria-label="Forrige dag">
                <i class="bi bi-chevron-left fs-4"></i>
            </button>

            <h3 class="fw-bold fs-5 fs-sm-3 mb-0 text-center">@currentDate.ToString("dd. MMMM yyyy")</h3>

            <button class="btn btn-primary px-3 py-2 shadow-sm" @onclick="NextDay" disabled="@(currentDate >= DateTime.Today)" aria-label="Næste dag">
                <i class="bi bi-chevron-right fs-4"></i>
            </button>
        </div>

        <ul class="nav custom-tabs mb-4 flex-nowrap">
            <li class="nav-item flex-grow-1 flex-md-grow-0 me-1 text-center">
                <a class="nav-link text-dark px-sm-5 py-sm-3 fs-6 fs-sm-5 px-2 py-2 @(activeDepartment == "Slottet" ? "active fw-bold" : "")"
                   @onclick='() => ChangeDepartment("Slottet")'>
                    Slottet <span class="badge bg-secondary ms-sm-2 ms-1">@Residents.Count(r => r.Department == "Slottet")</span>
                </a>
            </li>
            <li class="nav-item flex-grow-1 flex-md-grow-0 text-center">
                <a class="nav-link text-dark px-sm-5 py-sm-3 fs-6 fs-sm-5 px-2 py-2 @(activeDepartment == "Skoven" ? "active fw-bold" : "")"
                   @onclick='() => ChangeDepartment("Skoven")'>
                    Skoven <span class="badge bg-secondary ms-sm-2 ms-1">@Residents.Count(r => r.Department == "Skoven")</span>
                </a>
            </li>
        </ul>

        <div class="row g-4">
            @foreach (var resident in ActiveResidents)
            {
                <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                    <div class="card h-100 resident-card overflow-hidden border-0 shadow" style="cursor: pointer" @onclick="() => OpenResidentModal(resident)">
                        <div class="@GetRiskBgColor(resident.RiskLevel)" style="height: 20px; width: 100%;"></div>

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <h4 class="card-title fw-bold mb-0">@resident.Initials</h4>
                                <i class="bi bi-pencil-square text-muted"></i>
                            </div>

                            <div class="mb-2">
                                <strong>Personale:</strong>
                                @string.Join(", ", resident.Caretakers)
                            </div>
                            <div class="mb-2">
                                <strong>Humør:</strong> @resident.Mood
                            </div>
                            <div class="mb-3">
                                <strong>Medicin / PN:</strong>
                                <ul class="list-unstyled mb-0">
                                    @foreach (var med in resident.Medications)
                                    {
                                        <li class="small mb-1">
                                            <i class="bi bi-check-circle-fill text-primary me-1"></i> @med.Time - @med.Description
                                        </li>
                                    }
                                </ul>
                            </div>
                            <hr />
                            <p class="card-text small text-muted line-clamp-2" title="@resident.Note">
                                @resident.Note
                            </p>
                        </div>

                        <div class="card-footer border-top-0 text-muted small d-flex justify-content-between align-items-center bg-white pb-3">
                            <span>Ændret: @resident.LastEditedTime.ToString("HH:mm") af @resident.LastEditedBy</span>
                            <a href="#" @onclick:preventDefault class="text-decoration-none">Vis log</a>
                        </div>
                    </div>
                </div>
            }

            <div class="col-12 col-md-6 col-lg-4 col-xl-3">
                <div class="card h-100 ghost-card shadow-sm" @onclick="OpenCreateResidentModal">
                    <div class="card-body d-flex flex-column justify-content-center align-items-center text-secondary">
                        <i class="bi bi-plus-circle display-4 mb-3"></i>
                        <h5 class="fw-bold mb-0">Opret ny beboer</h5>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer class="bg-dark mt-auto py-4 text-white">
        <div class="container-fluid px-4">
            <div class="row g-4">
                <div class="col-md-6">
                    <div class="d-flex justify-content-between align-items-center border-bottom border-secondary mb-3 pb-2">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-person-badge me-2"></i>Ansvarsområder
                        </h5>
                        <button class="btn btn-outline-light btn-sm" @onclick="NotImplementedAlert"><i class="bi bi-gear-fill me-1"></i> Rediger</button>
                    </div>
                    <ul class="list-unstyled mb-0">
                        @foreach (var task in Responsibilities)
                        {
                            <li class="d-flex justify-content-between align-items-center bg-secondary mb-2 rounded bg-opacity-25 p-2">
                                <span><strong>@task.Title</strong></span>
                                <span class="badge bg-primary">@task.Assignee</span>
                            </li>
                        }
                    </ul>
                </div>
                <div class="col-md-6">
                    <div class="d-flex justify-content-between align-items-center border-bottom border-secondary mb-3 pb-2">
                        <h5 class="fw-bold mb-0">
                            <i class="bi bi-telephone-fill me-2"></i>Telefonliste
                        </h5>
                        <button class="btn btn-outline-light btn-sm" @onclick="NotImplementedAlert"><i class="bi bi-gear-fill me-1"></i> Rediger</button>
                    </div>
                    <ul class="list-unstyled mb-0">
                        @foreach (var phone in PhoneNumbers)
                        {
                            <li class="d-flex justify-content-between align-items-center bg-secondary mb-2 rounded bg-opacity-25 p-2">
                                <span>@phone.Name</span>
                                <a href="tel:@phone.Number.Replace(" ", "")" class="text-info text-decoration-none fw-bold">@phone.Number</a>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </footer>
</div>

@if (selectedResident != null)
{
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header @GetRiskBgColor(selectedResident.RiskLevel) border-0 text-white">
                    <h5 class="modal-title">@(isCreatingNew ? "Opret Ny Beboer" : $"Rediger Borger: {selectedResident.Initials}")</h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body">
                    <div class="row mb-3">
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Initialer</label>
                            <input type="text" class="form-control" @bind="selectedResident.Initials" disabled="@(!isCreatingNew)" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Afdeling</label>
                            <select class="form-select" @bind="selectedResident.Department" disabled="@(!isCreatingNew)">
                                <option value="Slottet">Slottet</option>
                                <option value="Skoven">Skoven</option>
                            </select>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label fw-bold">Risikovurdering</label>
                            <select class="form-select" @bind="selectedResident.RiskLevel">
                                <option value="Green">Fredelig (Grøn)</option>
                                <option value="Yellow">Utilregnelig (Gul)</option>
                                <option value="Red">Farlig (Rød)</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Humør</label>
                        <select class="form-select" @bind="selectedResident.Mood">
                            <option value="Glad">Glad</option>
                            <option value="Neutral">Neutral</option>
                            <option value="Ked af det">Ked af det</option>
                            <option value="Sur/Udadreagerende">Sur/Udadreagerende</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Fritekst (Aktiviteter, info, m.m.)</label>
                        <textarea class="form-control" rows="4" @bind="selectedResident.Note"></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-bold">Medicin og PN tiltag</label>
                        <ul class="list-group mb-2">
                            @foreach (var med in selectedResident.Medications)
                            {
                                <li class="list-group-item d-flex justify-content-between align-items-center">
                                    <span>@med.Time - @med.Description</span>
                                    <button class="btn btn-sm btn-outline-danger"><i class="bi bi-trash"></i></button>
                                </li>
                            }
                        </ul>
                        <button class="btn btn-sm btn-outline-primary">+ Tilføj medicin/PN</button>
                    </div>
                </div>
                <div class="modal-footer d-flex justify-content-between border-top-0 bg-light">
                    @if (!isCreatingNew)
                    {
                        <button type="button" class="btn btn-outline-danger" @onclick="ArchiveResident">
                            <i class="bi bi-archive-fill me-1"></i> Arkivér / Slet
                        </button>
                    }
                    else
                    {
                        <div></div>
                    }

                    <div>
                        <button type="button" class="btn-secondary btn" @onclick="CloseModal">Annuller</button>
                        <button type="button" class="btn-success btn" @onclick="SaveChanges">@(isCreatingNew ? "Opret Beboer" : "Gem ændringer")</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

<style>
    .resident-card {
        transition: transform 0.2s ease-in-out, box-shadow 0.2s ease-in-out;
    }

        .resident-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 1rem 3rem rgba(0,0,0,.175) !important;
        }

    .ghost-card {
        border: 2px dashed #adb5bd !important;
        background-color: transparent;
        transition: all 0.2s ease-in-out;
        cursor: pointer;
        min-height: 250px;
    }

        .ghost-card:hover {
            background-color: rgba(0, 0, 0, 0.03);
            border-color: #6c757d !important;
            color: #495057 !important;
            transform: translateY(-4px);
        }

    .line-clamp-2 {
        display: -webkit-box;
        -webkit-line-clamp: 2;
        -webkit-box-orient: vertical;
        overflow: hidden;
    }

    .custom-tabs {
        border-bottom: 1px solid var(--bs-border-color);
    }

        .custom-tabs .nav-link {
            cursor: pointer;
            background-color: var(--bs-light);
            border: 1px solid var(--bs-border-color);
            margin-bottom: -1px;
            border-radius: 0.375rem 0.375rem 0 0;
        }

            .custom-tabs .nav-link:hover {
                background-color: #e9ecef;
            }

            .custom-tabs .nav-link.active {
                background-color: #fff;
                border-bottom-color: #fff;
            }
</style>

@code {
    private DateTime currentDate = DateTime.Today;
    private string activeDepartment = "Slottet";
    private Resident? selectedResident;
    private bool isCreatingNew = false;

    // Models
    public class Resident
    {
        public string Id { get; set; } = Guid.NewGuid().ToString();
        public string Initials { get; set; } = "";
        public string Department { get; set; } = "";
        public string RiskLevel { get; set; } = "Green";
        public List<string> Caretakers { get; set; } = new();
        public string Mood { get; set; } = "Neutral";
        public string Note { get; set; } = "";
        public List<MedicationTask> Medications { get; set; } = new();
        public DateTime LastEditedTime { get; set; }
        public string LastEditedBy { get; set; } = "";
    }

    public class MedicationTask
    {
        public string Time { get; set; } = "";
        public string Description { get; set; } = "";
    }

    public class ResponsibilityArea
    {
        public string Title { get; set; } = "";
        public string Assignee { get; set; } = "";
    }

    public class PhoneContact
    {
        public string Name { get; set; } = "";
        public string Number { get; set; } = "";
    }

    private List<Resident> Residents = new();
    private IEnumerable<Resident> ActiveResidents => Residents.Where(r => r.Department == activeDepartment);

    private List<ResponsibilityArea> Responsibilities = new();
    private List<PhoneContact> PhoneNumbers = new();

    protected override void OnInitialized()
    {
        GenerateDummyData();
        GenerateFooterData();
    }

    private void PreviousDay() => currentDate = currentDate.AddDays(-1);

    private void NextDay()
    {
        if (currentDate < DateTime.Today) currentDate = currentDate.AddDays(1);
    }

    private void ChangeDepartment(string dept) => activeDepartment = dept;

    private void OpenResidentModal(Resident resident)
    {
        isCreatingNew = false;
        selectedResident = resident;
    }

    private void OpenCreateResidentModal()
    {
        isCreatingNew = true;
        selectedResident = new Resident
        {
            Department = activeDepartment,
            LastEditedTime = DateTime.Now,
            LastEditedBy = "Administrator"
        };
    }

    private void CloseModal()
    {
        selectedResident = null;
        isCreatingNew = false;
    }

    private void SaveChanges()
    {
        if (selectedResident != null)
        {
            if (isCreatingNew)
            {
                Residents.Add(selectedResident);
            }
            else
            {
                selectedResident.LastEditedTime = DateTime.Now;
                selectedResident.LastEditedBy = "Administrator";
            }
        }
        CloseModal();
    }

    private void ArchiveResident()
    {
        if (selectedResident != null)
        {
            Residents.Remove(selectedResident);
        }
        CloseModal();
    }

    private void NotImplementedAlert()
    {
        Console.WriteLine("Navigating to Admin CRUD module...");
    }

    private string GetRiskBgColor(string riskLevel) => riskLevel switch
    {
        "Red" => "bg-danger",
        "Yellow" => "bg-warning",
        "Green" => "bg-success",
        _ => "bg-secondary"
    };

    private void GenerateDummyData()
    {
        var random = new Random();
        string[] moods = { "Glad", "Neutral", "Ked af det", "Sur/Udadreagerende" };
        string[] risks = { "Green", "Green", "Green", "Yellow", "Yellow", "Red" };
        string[] caretakerNames = { "Jens H.", "Maria K.", "Søren P.", "Line N." };

        for (int i = 1; i <= 9; i++)
        {
            Residents.Add(CreateRandomResident($"B{i}", "Slottet", random, moods, risks, caretakerNames));
        }

        for (int i = 10; i <= 21; i++)
        {
            Residents.Add(CreateRandomResident($"B{i}", "Skoven", random, moods, risks, caretakerNames));
        }
    }

    private Resident CreateRandomResident(string initials, string dept, Random rnd, string[] moods, string[] risks, string[] caretakers)
    {
        int caretakerCount = rnd.Next(1, 3);
        var assignedCaretakers = caretakers.OrderBy(x => rnd.Next()).Take(caretakerCount).ToList();

        string noteText = rnd.Next(0, 2) == 0
            ? "Gik en tur i parken formiddag. Skal have hævet lommepenge til weekenden."
            : "Meget urolig til morgen. Har afvist at spise morgenmad og har haft behov for skærmning. Vi har forsøgt at tilbyde et bad, men det ønskede borgeren ikke.";

        return new Resident
        {
            Initials = initials,
            Department = dept,
            RiskLevel = risks[rnd.Next(risks.Length)],
            Mood = moods[rnd.Next(moods.Length)],
            Caretakers = assignedCaretakers,
            Note = noteText,
            LastEditedTime = DateTime.Today.AddHours(rnd.Next(7, 14)).AddMinutes(rnd.Next(0, 59)),
            LastEditedBy = caretakers[rnd.Next(caretakers.Length)],
            Medications = new List<MedicationTask>
            {
                new() { Time = "08:00", Description = "Morgenmedicin" },
                new() { Time = "12:00", Description = "Påføring af creme" }
            }
        };
    }

    private void GenerateFooterData()
    {
        Responsibilities = new List<ResponsibilityArea>
        {
            new() { Title = "Køkkenansvarlig", Assignee = "Personale A" },
            new() { Title = "Medicinansvarlig (Slottet)", Assignee = "Maria K." },
            new() { Title = "Medicinansvarlig (Skoven)", Assignee = "Jens H." },
            new() { Title = "Chauffør", Assignee = "Søren P." }
        };

        PhoneNumbers = new List<PhoneContact>
        {
            new() { Name = "Vagttelefon - Slottet", Number = "55 12 34 56" },
            new() { Name = "Vagttelefon - Skoven", Number = "55 12 34 57" },
            new() { Name = "Bagvagt (Leder)", Number = "22 33 44 55" },
            new() { Name = "Teknisk Service", Number = "88 88 88 88" }
        };
    }
}